{
  "manifest_version": 3,
  "name": "Tube Tweaks",
  "version": "1.0.0",
  "description": "Preferred quality with 1080p Premium, instant cinema mode, most popular comments, scroll mini player and a cleaner YouTube home feed.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tube Tweaks",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/settings.js", "src/numbers.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
