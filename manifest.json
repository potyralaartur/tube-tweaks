{
  "manifest_version": 3,
  "name": "Tube Tweaks",
  "version": "1.0.1",
  "description": "Tune YouTube: preferred quality, instant theater view, Most popular comment sort, a mini player and a Home feed without Shorts.",
  "homepage_url": "https://github.com/ptrl-design/tube-tweaks",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tube Tweaks",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/settings.js", "src/numbers.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
